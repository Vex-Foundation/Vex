# Pinned inputs for the Vex native runtime (bundled Postgres + pgvector and
# llama-server). Every build script sources this file and refuses to build from
# anything that does not match it. Bumping a pin is a reviewed change: update
# the value here, rebuild every target, and re-run the smoke and parity gates.
#
# Plain KEY=value lines only, so the file can be sourced by bash and parsed by
# Node without a shell.

# PostgreSQL. The checksum is the one ftp.postgresql.org publishes beside the
# tarball (postgresql-18.6.tar.bz2.sha256).
PG_VERSION=18.6
PG_URL=https://ftp.postgresql.org/pub/source/v18.6/postgresql-18.6.tar.bz2
PG_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f

# pgvector, pinned by tag AND commit; the checkout is refused if the tag has
# moved. 0.8.7 carries the 0.8.3 HNSW-vacuum and PG18 fixes and the 0.8.6/0.8.7
# IVFFlat overflow fixes.
PGVECTOR_REPO=https://github.com/pgvector/pgvector.git
PGVECTOR_TAG=v0.8.7
PGVECTOR_COMMIT=f37c13f68b57d2c3472b2214fbcff699d6d34876

# llama.cpp, the same tag as today's ghcr.io/ggml-org/llama.cpp:server-b9115
# image, so stored embeddings stay valid.
LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git
LLAMA_TAG=b9115
LLAMA_COMMIT=78fbbc2c0788efc8857a2c0dc9802ec689fa12c1

# Build tools, installed from PyPI into a private venv per host so a build
# never depends on whatever meson/ninja/cmake the machine happens to have.
MESON_VERSION=1.12.1
NINJA_VERSION=1.13.2
CMAKE_VERSION=4.4.4

# Platform floors (plan D13).
MACOS_DEPLOYMENT_TARGET=13.0
LINUX_GLIBC_MAX=2.35

# Linux binaries are built inside PyPA's manylinux_2_28 image: glibc 2.28 (well
# under the 2.35 ceiling of Ubuntu 22.04) with a current GCC toolset.
LINUX_BUILD_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:1e7b8460ad8fb3fb0fbe1cd818845159ac896b4fd17452d56e892c291f3b97a8
