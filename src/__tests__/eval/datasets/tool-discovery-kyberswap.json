      "awareness": "blind",
      "scenario": "evm_swap",
      "intentShape": "single",
      "expectedToolIds": [
        "kyberswap.swap.quote"
      ],
      "expectedCoverageGroups": [
        [
          "kyberswap.swap.quote"
        ]
      ]
    },
