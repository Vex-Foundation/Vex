  "handshake": {
    "request": {
      "valid": "{\"v\":1,\"projectId\":\"3f2504e0-4f89-41d3-9a0c-0305e82c3301\"}\n"
    },
    "acks": {
      "accepted": "{\"ok\":true}\n",
      "refusalCodes": [
        "unknown_project",
        "incompatible_version",
        "locked",
        "at_capacity",
        "malformed"
      ]
    },
    "cases": [
      {
        "name": "valid handshake",
        "line": "{\"v\":1,\"projectId\":\"3f2504e0-4f89-41d3-9a0c-0305e82c3301\"}\n",
        "expect": {
          "kind": "accepted",
          "projectId": "3f2504e0-4f89-41d3-9a0c-0305e82c3301",
          "remainder": ""
        }
      },
      {
        "name": "coalesced handshake and initialize in one chunk",
        "line": "{\"v\":1,\"projectId\":\"3f2504e0-4f89-41d3-9a0c-0305e82c3301\"}\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n",
        "expect": {
          "kind": "accepted",
          "projectId": "3f2504e0-4f89-41d3-9a0c-0305e82c3301",
          "remainder": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n"
        }
      },
      {
        "name": "unknown major version",
        "line": "{\"v\":2,\"projectId\":\"3f2504e0-4f89-41d3-9a0c-0305e82c3301\"}\n",
        "expect": {
          "kind": "refused",
          "code": "incompatible_version"
        }
      },
      {
        "name": "missing version",
        "line": "{\"projectId\":\"3f2504e0-4f89-41d3-9a0c-0305e82c3301\"}\n",
        "expect": {
          "kind": "refused",
          "code": "malformed"
        }
      },
      {
        "name": "projectId that is not a uuid",
        "line": "{\"v\":1,\"projectId\":\"not-a-uuid\"}\n",
        "expect": {
          "kind": "refused",
          "code": "malformed"
        }
      },
      {
        "name": "not JSON",
        "line": "hello\n",
        "expect": {
          "kind": "refused",
          "code": "malformed"
        }
      },
      {
        "name": "a JSON array is not a handshake",
        "line": "[1,2]\n",
        "expect": {
          "kind": "refused",
          "code": "malformed"
        }
      },
      {
        "name": "incomplete line is pending",
        "line": "{\"v\":1,",
        "expect": {
          "kind": "pending"
        }
      }
    ]
  }
