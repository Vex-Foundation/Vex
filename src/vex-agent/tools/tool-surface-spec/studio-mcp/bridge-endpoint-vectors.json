  "hashRules": {
    "algorithm": "sha256",
    "encoding": "lowercase hex, first 12 characters",
    "fileNameTemplate": "vex-studio-<hash>.sock",
    "input": "the exact UTF-8 bytes of the resolved config-directory string",
    "forbidden": [
      "byte-order mark",
      "trailing newline",
      "case folding",
      "Unicode normalisation (NFC/NFD)",
      "separator conversion",
      "filepath.Clean / path.normalize"
    ],
    "onSymlinkEvalSuccess": "hash the RESOLVED path. Go filepath.EvalSymlinks CLEANS a successful result and Node realpathSync returns a canonical path, so both sides arrive at the same cleaned string; that agreement is the reason success is the only branch allowed to clean.",
    "onSymlinkEvalFailure": "hash the ORIGINAL literal string with NO Clean. Failure is every first run, before the directory exists, and a side that cleaned there would derive a different endpoint from the side that did not.",
    "tmpdirNeverRealpathed": "The endpoint parent under the temporary directory is used AS REPORTED by the platform. Realpathing it would move macOS from /var/folders/... to /private/var/folders/... on one side only.",
    "cases": [
      {
        "name": "a resolvable macOS path: /var is a symlink to /private/var, so the RESOLVED form is hashed",
        "literal": "/var/root/Library/Application Support/vex",
        "resolved": "/private/var/root/Library/Application Support/vex",
        "hashOf": "resolved",
        "hash": "4ed13594a5b5",
        "literalHash": "2d3edd332258"
      },
      {
        "name": "an unresolvable path is hashed as the ORIGINAL literal, with NO Clean",
        "literal": "/home/alice/./.config//vex",
        "resolved": null,
        "hashOf": "literal",
        "hash": "91f8b8415f32",
        "cleaned": "/home/alice/.config/vex",
        "cleanedHash": "7ea66dd102b3"
      },
      {
        "name": "a trailing separator is a DIFFERENT string and therefore a different endpoint",
        "literal": "/home/alice/.config/vex/",
        "resolved": null,
        "hashOf": "literal",
        "hash": "5453893f0a39"
      },
      {
        "name": "a windows config directory is hashed with its backslashes, never converted",
        "literal": "C:\\Users\\alice\\AppData\\Roaming\\vex",
        "resolved": null,
        "hashOf": "literal",
        "hash": "742dab34d2e9"
      },
      {
        "name": "case is NOT folded: two spellings of one windows path are two endpoints",
        "literal": "C:\\users\\alice\\AppData\\Roaming\\vex",
        "resolved": null,
        "hashOf": "literal",
        "hash": "b438d5447bb5"
      },
      {
        "name": "Unicode is NOT normalised: the NFD spelling of a precomposed name is a different endpoint",
        "literal": "/home/alicé/.config/vex",
        "resolved": null,
        "hashOf": "literal",
        "hash": "0239bfa80002",
        "nfcForm": "/home/alicé/.config/vex",
        "nfcHash": "adaadbec188f"
      }
    ]
  },
