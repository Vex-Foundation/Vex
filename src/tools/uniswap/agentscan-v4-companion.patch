+ALTER TABLE activities ADD COLUMN route jsonb;
+ALTER TABLE activities ADD CONSTRAINT uniswap_v4_route_role CHECK (
+  route IS NULL OR (protocol = 'uniswap' AND kind = 'swap' AND event_role = 'swap')
+);
