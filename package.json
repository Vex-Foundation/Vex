{
  "name": "@vex/vex",
  "version": "1.0.0",
  "private": true,
  "description": "Vex desktop app workspace and local agent runtime",
  "type": "module",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.cjs",
    "build": "pnpm run clean && pnpm exec tsc && pnpm exec tsc-alias --outDir dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test:ratchet": "node scripts/check-test-type-baseline.mjs",
    "typecheck:test:baseline-diff": "node scripts/check-test-type-baseline-change.mjs",
    "test:unsafe-escapes": "node scripts/check-test-unsafe-escapes.mjs",
    "check:em-dash": "node scripts/check-no-em-dash.mjs",
    "test:integration": "vitest run --config vitest/integration.config.ts",
    "test:eval": "vitest run --config vitest/eval.config.ts",
    "test:eval:e2e": "VEX_E2E_MEMORY_EVAL=1 vitest run --config vitest/eval.config.ts src/__tests__/integration/eval/e2e-memory-correctness.int.test.ts",
    "test:eval:e2e:full": "VEX_E2E_MEMORY_EVAL=1 VEX_E2E_SUBSET=full vitest run --config vitest/eval.config.ts src/__tests__/integration/eval/e2e-memory-correctness.int.test.ts",
    "test:bench:judge": "VEX_JUDGE_BENCH=1 vitest run --config vitest/eval.config.ts src/__tests__/integration/eval/judge-benchmark.int.test.ts",
    "test:eval:lexical": "tsx src/__tests__/eval/lexical-baseline-cli.ts",
    "test:eval:lexical:update": "tsx src/__tests__/eval/lexical-baseline-cli.ts --update",
    "tool-retrieval-probe": "tsx src/__tests__/eval/discovery-probe-cli.ts",
    "test:eval:dense": "VEX_REAL_DENSE_EVAL=1 VEX_EVAL_BASELINE_MODE=check vitest run --config vitest/dense-eval.config.ts",
    "test:eval:dense:update": "VEX_REAL_DENSE_EVAL=1 VEX_EVAL_BASELINE_MODE=update vitest run --config vitest/dense-eval.config.ts",
    "test:eval:latency": "VEX_REAL_LATENCY_EVAL=1 vitest run --config vitest/latency-eval.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "knowledge-export": "tsx src/vex-agent/scripts/knowledge-export.ts",
    "knowledge-import": "tsx src/vex-agent/scripts/knowledge-import.ts",
    "knowledge-reembed": "tsx src/vex-agent/scripts/knowledge-reembed.ts",
    "tool-reembed": "tsx src/vex-agent/scripts/tool-reembed.ts",
    "tool-embeddings:health": "tsx src/vex-agent/scripts/tool-embeddings-health.ts",
    "prompt-budget:report": "tsx src/vex-agent/scripts/prompt-budget-report.ts",
    "measure:khalani-gas-ratio": "tsx src/vex-agent/scripts/measure-khalani-provider-gas-ratio.ts",
    "measure:solana-priority-fee": "tsx src/vex-agent/scripts/measure-solana-priority-fee-exposure.ts",
    "benchmark-cross-lingual": "tsx src/vex-agent/scripts/cross-lingual-benchmark.ts",
    "vex:dev": "pnpm --dir vex-app install && pnpm --dir vex-app dev",
    "vex:make": "pnpm --dir vex-app make",
    "vex:lint": "pnpm --dir vex-app lint",
    "vex:test": "pnpm --dir vex-app test",
    "vex:test:e2e": "pnpm --dir vex-app test:e2e"
  },
  "dependencies": {
    "@morpho-org/morpho-sdk": "5.5.0",
    "@openrouter/sdk": "^1.1.13",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@tavily/core": "^0.7.2",
    "bs58": "^6.0.0",
    "ethers": "^6.13.1",
    "pg": "^8.20.0",
    "rettiwt-api": "7.1.2",
    "socket.io-client": "^4.8.3",
    "tweetnacl": "1.0.3",
    "viem": "2.54.3",
    "winston": "^3.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.18.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.1"
  },
  "keywords": [
    "defi",
    "blockchain",
    "desktop",
    "agent"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vex-Foundation/Vex.git"
  },
  "homepage": "https://github.com/Vex-Foundation/Vex",
  "bugs": {
    "url": "https://github.com/Vex-Foundation/Vex/issues"
  },
  "packageManager": "pnpm@10.32.1"
}
